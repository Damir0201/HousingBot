# ---------- App ----------
# ENVIRONMENT: local | production | test
ENVIRONMENT=local
LOG_LEVEL=INFO
TIMEZONE=Europe/Rome
# DEFAULT_LANGUAGE: ru | en | it
DEFAULT_LANGUAGE=ru

# ---------- Telegram ----------
BOT_TOKEN=123456:replace-me
# BOT_MODE: polling (local, separate "bot" service) | webhook (prod, served by "api")
BOT_MODE=polling
# Public HTTPS URL for webhook mode, e.g. https://domik.example.com
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=change-me-long-random-string
# Telegram IDs of agency owners (comma separated). They get the "owner" role.
OWNER_IDS=111111111

# ---------- REST API ----------
API_KEY=change-me-api-key

# ---------- PostgreSQL ----------
POSTGRES_USER=domik
POSTGRES_PASSWORD=domik
POSTGRES_DB=domik
DATABASE_URL=postgresql+asyncpg://domik:domik@localhost:5432/domik

# ---------- Redis / Celery ----------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------- LLM (any OpenAI-compatible API) ----------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=30

# ---------- Excel sync ----------
EXCEL_PATH=data/properties.xlsx
EXCEL_SYNC_INTERVAL_SECONDS=300

# ---------- Bookings ----------
BOOKING_SLOT_MINUTES=30
BOOKING_BUFFER_MINUTES=15
BOOKING_WORK_START=09:00
BOOKING_WORK_END=20:00
BOOKING_DAYS_AHEAD=14
REMINDER_MINUTES_BEFORE=15
LATE_EXTENSION_MINUTES=15
